# Admin Folder Protection
# Basic Authentication

<Files ~ "\.(php)$">
    AuthType Basic
    AuthName "Admin Area - Login Required"
    AuthUserFile /home/[YOUR_CPANEL_USERNAME]/public_html/.htpasswd
    Require valid-user
</Files>

<Directory /home/[YOUR_CPANEL_USERNAME]/public_html/admin>
    AuthType Basic
    AuthName "Admin Area - Login Required"
    AuthUserFile /home/[YOUR_CPANEL_USERNAME]/public_html/.htpasswd
    Require valid-user
</Directory>
