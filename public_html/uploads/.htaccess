# Deny execution of PHP files inside uploads (safety)
<FilesMatch "\.(php|php5|phtml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# Allow images to be served
<FilesMatch "\.(jpg|jpeg|png|webp|gif)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>