# .htaccess - Block sensitive files and disable directory listing
Options -Indexes

# Deny direct access to config.php
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</Files>

# Prevent access to dotfiles
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Deny execution of PHP in uploads folder (additional safety)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/.*\.(php|phtml|php5)$ - [F,L,NC]
</IfModule>

# Enable Gzip compression (recommended on VPS)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Caching for uploaded images
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# SPA routing: send non-file/non-directory requests to index.html (allow /api/* to pass through)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Don't rewrite requests for existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Allow API endpoints to be served normally
  RewriteRule ^api/ - [L]

  # Fallback to index.html for client-side routing (enables /admin, /car/123, etc.)
  RewriteRule ^ index.html [L]
</IfModule>